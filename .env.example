# =============================================================================
# SS Audios Backend Environment Configuration (Erode, Tamil Nadu)
# =============================================================================

# Server Port (Local Development)
PORT=5000

# Allowed Origin for CORS (e.g. http://localhost:5173, http://localhost:3000, or * for all)
ALLOWED_ORIGIN=*

# Owner & Notification Email
OWNER_EMAIL=connectjawa@gmail.com

# Optional server-side passcode for SS Audios Admin Portal
# If left empty, first-run admin setup lets owner claim a password
ADMIN_PASSCODE=

# Secret for signing admin HMAC session tokens (min 16 chars)
SESSION_SECRET=ss-audios-production-secret-token-key-2026

# Google Gemini API Key (Required for AI Studio features: advisor, blueprint, image, video)
GEMINI_API_KEY=

# AWS Configuration (for Media Vault & DynamoDB storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=soundscape-media-vault-ap-south-1
DYNAMODB_TABLE_NAME=SoundscapeMedia
DYNAMODB_SERVICES_TABLE=SoundscapeServices
DYNAMODB_PLANS_TABLE=SoundscapePlans
DYNAMODB_INQUIRIES_TABLE=SoundscapeInquiries
DYNAMODB_STORE_TABLE=SoundscapeStore

# Email Notification Service (Gmail App Password / Nodemailer & Resend)
EMAIL_USER=ssaudios25@gmail.com
EMAIL_PASS=your_gmail_app_password
RESEND_API_KEY=your_resend_api_key_optional

# =============================================================================
# Soundscape Backend Environment Configuration
# =============================================================================

# Server Port (Local Development)
PORT=5000

# Allowed Origin for CORS (e.g., http://localhost:5173, https://your-frontend.vercel.app, or * for all)
ALLOWED_ORIGIN=*

# AWS Configuration (for Media Vault & DynamoDB storage)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
S3_BUCKET_NAME=soundscape-media-vault-ap-south-1
DYNAMODB_TABLE_NAME=SoundscapeMedia
DYNAMODB_SERVICES_TABLE=SoundscapeServices
DYNAMODB_PLANS_TABLE=SoundscapePlans
DYNAMODB_INQUIRIES_TABLE=SoundscapeInquiries

# Email Notification Service (Gmail App Password / Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
RESEND_API_KEY=your_resend_api_key_optional
